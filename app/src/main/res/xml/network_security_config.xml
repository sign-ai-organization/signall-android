<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin texto en claro. El SRS pide que todo lo que sale del dispositivo vaya
  cifrado (`main.tex:1095`) y que el enlace con el backend sea WSS (`:1100`);
  desde API 28 Android tampoco lo permite por defecto, así que este archivo lo
  hace explícito en vez de dejarlo en el comportamiento de la plataforma.

  El build type `debug` reemplaza este archivo por uno que sí lo permite, contra
  el backend de desarrollo. Es el **único** caso en que el tráfico viaja sin
  cifrar y el único donde RF-INT-COM-03 se incumple a propósito.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>