<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 29+ only. The app ships its own light/dark palette (Settings.darkTheme),
         so we must not let the OEM force-dark ("smart dark" on MIUI) invert it.
         Without this, MIUI inverts text drawn inside hardware layers (scroll
         containers, drawers): dark text renders white while solid boxes stay
         correct. Do not remove. -->
    <style name="Theme.SignALL" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
