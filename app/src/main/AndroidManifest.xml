<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Descubrimiento automático del backend. `ACCESS_NETWORK_STATE` es para
         leer la IP y la máscara de la red activa con LinkProperties;
         `ACCESS_WIFI_STATE`/`CHANGE_WIFI_MULTICAST_STATE` son para el
         MulticastLock que necesita mDNS (sin él, MIUI y otros fabricantes
         filtran el multicast). No son permisos de runtime. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- The app translates what the user says; without the mic it can only
         accept typed phrases (RF-UI-04). -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- `windowSoftInputMode` es atributo de `<activity>`, no de `<application>`:
         puesto en la aplicación el sistema lo ignora y la ventana queda en el
         default (`adjustPan`). Con `adjustPan` el sistema **panea** la ventana
         entera hacia arriba cuando el teclado se abre, y encima la app también
         reserva el inset del teclado (`imePadding` en `SignAllBottomBar`): se
         sumaban los dos desplazamientos y quedaba un hueco de ~200 dp entre el
         teclado y los botones (owner, 2026-10-22). Con `adjustResize` y
         edge-to-edge (`enableEdgeToEdge`) la ventana no se resizea ni se panea:
         el único que mueve el panel es el inset, que es el que está medido. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SignALL">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
