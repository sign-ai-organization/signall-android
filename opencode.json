{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-pty-v2"],
  "mcp": {
    "servers": {
      "mobile-mcp": {
        "type": "local",
        "command": ["/home/diegocachy/.local/bin/mcp-server-mobile"],
        "environment": {
          "MOBILEMCP_DISABLE_TELEMETRY": "1"
        },
        "timeout": {
          "startup": 60000
        }
      },
      "neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp"
      }
    }
  }
}
