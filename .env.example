# Plantilla de credenciales para correr el backend desde esta carpeta.
#
#   cp .env.example env
#
# El archivo resultante (`env`) está en .gitignore: contiene la contraseña de
# Neon y la API key del LLM, y no deben llegar nunca al repo.
#
# Esta es una copia local de `../sign-ai-backend/.env`. La app Android no lee
# este archivo: la dirección del backend se le pasa por compilación, con
#
#   ./gradlew installDebug -Psignai.backendWsUrl=ws://<IP>:8080/ws/translate
#
# Ver ../sign-ai-backend/docs/android-integration.md para el protocolo completo.

APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# Tiempos por paso del pipeline hacia el cliente ("trace"). Solo para depurar:
# el cliente Android los ignora.
DEBUG_TRACE_ENABLED=false

# Neon PostgreSQL. La contraseña va acá: no la subas.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Pool de asyncpg, abierto (y calentado) al arrancar.
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=10
# 0 = nunca cerrar conexiones ociosas del pool (el keep-alive decide cuándo).
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME_SECONDS=0

# Mantiene Neon despierto si hubo actividad reciente, para que su apagado a los
# 5 min no caiga en la frase siguiente. 0 = apagado.
DB_KEEPALIVE_INTERVAL_SECONDS=240
DB_KEEPALIVE_IDLE_WINDOW_SECONDS=1200

# Proveedor externo de LLM.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_MS=10000

# Distancia coseno máxima (pgvector <=>) para que un acierto del caché semántico
# cuente como acierto. Más bajo = más estricto.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.05

# Servicio STT (sign-ai-stt). Por defecto el nombre del servicio en
# docker-compose.yml; poné ws://localhost:8000/ws/transcribe si corrés el
# backend fuera de Docker contra un STT local.
STT_WS_URL=ws://stt:8000/ws/transcribe

# false = traducir el texto entero como una sola oración. Los demás parámetros
# (listas de palabras, umbrales) traen los valores ya evaluados; se ajustan con
# SENTENCE_SEGMENTER__<CAMPO>. Ver app/config/sentence_segmenter.py.
SENTENCE_SEGMENTER__ENABLED=true