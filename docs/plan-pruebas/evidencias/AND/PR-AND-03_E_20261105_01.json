      "ms": 8844
    },
    {
      "n": 2,
      "id": "FR-01-003",
      "texto": "Mi abuelo y mi tío trabajan en familia.",
      "t": 1793890775745,
      "t_fin": 1793890788553,
      "ms": 12808
    },
    {
      "n": 3,
      "id": "FR-01-007",
      "texto": "¿Tienes hambre?",
      "t": 1793890789559,
      "t_fin": 1793890797966,
      "ms": 8407
    },
    {
      "n": 4,
      "id": "FR-01-010",
      "texto": "Tu hermano está triste. ¿Se siente mal?",
      "t": 1793890798893,
      "t_fin": 1793890814561,
      "ms": 15668
    },
    {
      "n": 5,
      "id": "FR-01-013",
      "texto": "Hola, ¿cómo estás? ¿Cómo te llamas?",
      "t": 1793890815557,
      "t_fin": 1793890828051,
      "ms": 12494
    },
    {
      "n": 6,
      "id": "FR-01-014",
      "texto": "¿Dónde vive tu familia?",
      "t": 1793890829058,
      "t_fin": 1793890841429,
      "ms": 12371
    },
    {
      "n": 7,
      "id": "FR-01-019",
      "texto": "Yo nunca como mucho.",
      "t": 1793890842332,
      "t_fin": 1793890855169,
      "ms": 12837
    },
    {
      "n": 8,
      "id": "FR-01-021",
      "texto": "Mi tío nunca está aburrido.",
      "t": 1793890856211,
      "t_fin": 1793890867276,
      "ms": 11065
    },
    {
      "n": 9,
      "id": "FR-01-024",
      "texto": "Se siente muy bien. La niña nunca está triste.",
      "t": 1793890868272,
      "t_fin": 1793890885402,
      "ms": 17130
    },
    {
      "n": 10,
      "id": "FR-01-026",
      "texto": "Con permiso. Déjame pasar, por favor.",
      "t": 1793890886376,
      "t_fin": 1793890894000,
      "ms": 7624
    },
    {
      "n": 11,
      "id": "FR-01-028",
      "texto": "Hermano, vive con el abuelo. Trabaja con el tío.",
      "t": 1793890894941,
      "t_fin": 1793890910732,
      "ms": 15791
