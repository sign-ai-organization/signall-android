      },
      {
        "frase": "FR-01-005",
        "audio": "AU-01-007",
        "duracion_ms": 5205,
        "ms": 5473.2,
        "transcrito": "Buenas tardes. Hoy me siento más o menos.",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 14
      },
      {
        "frase": "FR-01-007",
        "audio": "AU-01-013",
        "duracion_ms": 2688,
        "ms": 2939.1,
        "transcrito": "¿Tienes hambre?",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 8
      },
      {
        "frase": "FR-01-011",
        "audio": "AU-01-019",
        "duracion_ms": 3989,
        "ms": 4207.4,
        "transcrito": "Perdón, ¿estás triste?",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 13
      },
      {
        "frase": "FR-01-013",
        "audio": "AU-01-025",
        "duracion_ms": 4010,
        "ms": 4275.1,
        "transcrito": "Hola, ¿cómo estás? ¿Cómo te llamas?",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 16
      },
      {
        "frase": "FR-01-014",
        "audio": "AU-01-031",
        "duracion_ms": 3605,
        "ms": 3844.9,
        "transcrito": "¿Dónde vive tu familia?",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 9
      },
      {
        "frase": "FR-01-019",
        "audio": "AU-01-037",
        "duracion_ms": 3648,
        "ms": 3860.3,
        "transcrito": "Yo nunca como mucho.",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 9
      },
      {
        "frase": "FR-01-023",
        "audio": "AU-01-043",
        "duracion_ms": 5120,
        "ms": 6380.2,
        "transcrito": "Perdón, mi hermano nunca está contento.",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 13
      },
      {
        "frase": "FR-01-025",
        "audio": "AU-01-049",
        "duracion_ms": 3648,
        "ms": 3860.1,
        "transcrito": "Por favor, come poco.",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 10
      },
      {
        "frase": "FR-01-026",
        "audio": "AU-01-055",
        "duracion_ms": 5056,
        "ms": 6399.6,
        "transcrito": "Con permiso, déjame pasar, por favor.",
        "cancelado": false,
        "error": false,
        "timeout": false,
        "frames": 12
      }
